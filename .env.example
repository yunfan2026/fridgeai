# Copy to `.env` (client) and `local.env` (server) and fill in.

# ── Client (Vite) — public, embedded in the browser bundle ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...   # Supabase → Settings → API → anon/public key

# ── Server (local.env) — secret, never sent to the browser ──
GEMINI_API_KEY=your-gemini-key       # Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
